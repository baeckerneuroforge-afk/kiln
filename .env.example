# PostgreSQL connection string used by Prisma in app/runtime queries. Get this from your Supabase or managed Postgres project.
DATABASE_URL=postgresql://...

# Direct PostgreSQL connection used for Prisma migrations and schema operations (must NOT be a pooled/PgBouncer connection).
# Get this from your database provider's direct connection settings.
DIRECT_URL=postgresql://...

# Clerk publishable key used by the browser auth client. Get this from Clerk Dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Clerk secret key used by server-side auth. Get this from Clerk Dashboard -> API Keys.
CLERK_SECRET_KEY=sk_live_...

# Public base URL used for links, embeds, and callbacks. Set this to your production domain.
NEXT_PUBLIC_APP_URL=https://kilnbase.com

# Canonical app domain used by middleware and domain detection. Set this to your production hostname.
NEXT_PUBLIC_APP_DOMAIN=kilnbase.com

# Calendly booking URL used for enterprise demo/contact-sales CTAs. Set this to your team booking page.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/kilnbase/enterprise

# Optional Google OAuth client ID for Google Calendar integration. Reuse your existing Google OAuth app or create a separate one with Calendar scope.
# If omitted, the app falls back to GOOGLE_CLIENT_ID when available.
GOOGLE_CALENDAR_CLIENT_ID=

# Optional Google OAuth client secret for Google Calendar integration. Pair this with GOOGLE_CALENDAR_CLIENT_ID.
# If omitted, the app falls back to GOOGLE_CLIENT_SECRET when available.
GOOGLE_CALENDAR_CLIENT_SECRET=

# Exact Google Calendar OAuth callback URL configured in Google Cloud Console for your OAuth client.
# This must match the authorized redirect URI exactly. If omitted, KILN falls back to NEXT_PUBLIC_APP_URL + /api/integrations/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://kilnbase.com/api/integrations/google-calendar/callback

# Before using Google Calendar OAuth, enable the Google Calendar API in Google Cloud Console for the same project as your OAuth client.

# Gmail OAuth callback URL. Uses the same Google OAuth client as Calendar — just needs gmail.readonly and gmail.send scopes added.
# Add this as an authorized redirect URI in Google Cloud Console alongside the Calendar one.
GMAIL_REDIRECT_URI=https://kilnbase.com/api/integrations/gmail/callback

# Google Sheets OAuth callback URL. Uses the same Google OAuth client — needs Sheets API enabled + spreadsheets scope.
# Add this as an authorized redirect URI in Google Cloud Console.
GOOGLE_SHEETS_REDIRECT_URI=https://kilnbase.com/api/integrations/google-sheets/callback

# HubSpot OAuth client ID for CRM/contact sync. Get this from HubSpot Developer -> Apps -> Auth.
HUBSPOT_CLIENT_ID=...

# HubSpot OAuth client secret paired with HUBSPOT_CLIENT_ID. Get this from HubSpot Developer -> Apps -> Auth.
HUBSPOT_CLIENT_SECRET=...

# HubSpot OAuth callback URL configured in your HubSpot app. Usually https://your-domain/api/integrations/hubspot/callback
HUBSPOT_REDIRECT_URI=https://kilnbase.com/api/integrations/hubspot/callback

# Anthropic API key for Claude models. Get this from console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key for embeddings and OpenAI models. Get this from platform.openai.com -> API keys.
OPENAI_API_KEY=sk-...

# Optional: ScreenshotOne API key for Computer Use agent screenshots. Get this from screenshotone.com -> Dashboard -> API Keys.
# If omitted, Computer Use agents work in HTML-only mode (no visual screenshots).
SCREENSHOT_API_KEY=

# Optional: Browserless API key for real browser control in Computer Use V2.0. Get this from browserless.io -> Dashboard.
# If omitted, Computer Use falls back to HTTP-fetching + screenshot mode.
BROWSERLESS_API_KEY=

# Optional: Perplexity API key for Deep Research node and Agentic RAG multi-source search. Get this from perplexity.ai -> API.
PERPLEXITY_API_KEY=

# Supabase project URL used by the client and server SDKs. Get this from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://...

# Supabase anon key used by public/client requests. Get this from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key used by privileged server-side operations. Get this from Supabase Dashboard -> Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe secret key used for billing, checkout, and webhooks. Get this from Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_live_...

# Stripe publishable key used by the frontend checkout flow. Get this from Stripe Dashboard -> Developers -> API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe webhook signing secret used to verify incoming webhook events. Get this from Stripe Dashboard -> Developers -> Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price ID for the Starter monthly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...

# Stripe Price ID for the Pro monthly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...

# Stripe Price ID for the Agency monthly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_AGENCY_PRICE_ID=price_...

# Stripe Price ID for the Starter yearly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_STARTER_YEARLY_PRICE_ID=price_...

# Stripe Price ID for the Pro yearly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_...

# Stripe Price ID for the Agency yearly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_AGENCY_YEARLY_PRICE_ID=price_...

# Resend API key used for transactional email delivery. Get this from resend.com -> API Keys.
RESEND_API_KEY=re_...

# Encryption key used to encrypt stored provider/API secrets. Generate a 64-character hex key with: openssl rand -hex 32
ENCRYPTION_KEY=32-byte-hex-string

# Shared secret used to authenticate Vercel cron requests. Set this manually in Vercel environment variables.
CRON_SECRET=your-cron-secret

# Comma-separated Clerk user IDs that should have admin access. Get these from Clerk Dashboard -> Users.
ADMIN_USER_IDS=user_...

# Upstash Redis REST URL used for distributed rate limiting. Get this from Upstash Console -> Redis database details.
UPSTASH_REDIS_REST_URL=https://...

# Upstash Redis REST token used for distributed rate limiting. Get this from Upstash Console -> Redis database details.
UPSTASH_REDIS_REST_TOKEN=...

# Sentry DSN used for server-side error reporting. Get this from Sentry -> Project Settings -> Client Keys (DSN).
SENTRY_DSN=https://...@sentry.io/...

# Public Sentry DSN used for browser-side error reporting. Usually the same DSN as above from Sentry -> Project Settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Notion OAuth credentials for the Notion integration. Get these from https://www.notion.so/my-integrations -> Create new integration -> OAuth.
NOTION_CLIENT_ID=...
NOTION_CLIENT_SECRET=...
NOTION_REDIRECT_URI=https://kilnbase.com/api/integrations/notion/callback

# Slack OAuth credentials for the Slack integration. Create a Slack App at https://api.slack.com/apps.
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...

# Slack signing secret for verifying webhook requests. Get this from Slack App -> Basic Information -> Signing Secret.
SLACK_SIGNING_SECRET=...

# WhatsApp webhook verification token. Set this to any random string, then use the same value when configuring the webhook in Meta Developer Portal.
WHATSAPP_VERIFY_TOKEN=your-random-verify-token

# Optional: Meta App Secret for webhook signature verification. Get this from Meta Developer Portal -> App Settings -> Basic -> App Secret.
WHATSAPP_APP_SECRET=
