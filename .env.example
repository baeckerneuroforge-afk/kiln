# PostgreSQL connection string used by Prisma in app/runtime queries. Get this from your Supabase or managed Postgres project.
DATABASE_URL=postgresql://...

# Direct PostgreSQL connection used for Prisma schema operations. Get this from your database provider's direct connection settings.
DIRECT_URL=postgresql://...

# Clerk publishable key used by the browser auth client. Get this from Clerk Dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Clerk secret key used by server-side auth. Get this from Clerk Dashboard -> API Keys.
CLERK_SECRET_KEY=sk_live_...

# Public base URL used for links, embeds, and callbacks. Set this to your production domain.
NEXT_PUBLIC_APP_URL=https://kilnbase.com

# Canonical app domain used by middleware and domain detection. Set this to your production hostname.
NEXT_PUBLIC_APP_DOMAIN=kilnbase.com

# Anthropic API key for Claude models. Get this from console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key for embeddings and OpenAI models. Get this from platform.openai.com -> API keys.
OPENAI_API_KEY=sk-...

# Supabase project URL used by the client and server SDKs. Get this from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://...

# Supabase anon key used by public/client requests. Get this from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key used by privileged server-side operations. Get this from Supabase Dashboard -> Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe secret key used for billing, checkout, and webhooks. Get this from Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_live_...

# Stripe publishable key used by the frontend checkout flow. Get this from Stripe Dashboard -> Developers -> API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe webhook signing secret used to verify incoming webhook events. Get this from Stripe Dashboard -> Developers -> Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price ID for the Starter monthly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...

# Stripe Price ID for the Pro monthly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...

# Stripe Price ID for the Agency monthly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_AGENCY_PRICE_ID=price_...

# Stripe Price ID for the Starter yearly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_STARTER_YEARLY_PRICE_ID=price_...

# Stripe Price ID for the Pro yearly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_...

# Stripe Price ID for the Agency yearly plan. Get this from Stripe Dashboard -> Products.
NEXT_PUBLIC_STRIPE_AGENCY_YEARLY_PRICE_ID=price_...

# Resend API key used for transactional email delivery. Get this from resend.com -> API Keys.
RESEND_API_KEY=re_...

# Encryption key used to encrypt stored provider/API secrets. Generate a 64-character hex key with: openssl rand -hex 32
ENCRYPTION_KEY=32-byte-hex-string

# Shared secret used to authenticate Vercel cron requests. Set this manually in Vercel environment variables.
CRON_SECRET=your-cron-secret

# Comma-separated Clerk user IDs that should have admin access. Get these from Clerk Dashboard -> Users.
ADMIN_USER_IDS=user_...

# Upstash Redis REST URL used for distributed rate limiting. Get this from Upstash Console -> Redis database details.
UPSTASH_REDIS_REST_URL=https://...

# Upstash Redis REST token used for distributed rate limiting. Get this from Upstash Console -> Redis database details.
UPSTASH_REDIS_REST_TOKEN=...

# Sentry DSN used for server-side error reporting. Get this from Sentry -> Project Settings -> Client Keys (DSN).
SENTRY_DSN=https://...@sentry.io/...

# Public Sentry DSN used for browser-side error reporting. Usually the same DSN as above from Sentry -> Project Settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
