// ── Feature: Data Pipeline ──────────────────────────

model DataConnection {
  id                   String    @id @default(cuid())
  userId               String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  name                 String
  type                 String    // postgresql, mysql, snowflake, bigquery, supabase, sqlite, rest_api
  encryptedConfig      String    // AES-256-GCM encrypted JSON with connection details
  status               String    @default("disconnected") // connected, disconnected, error
  schemaCache          Json?     // cached table/column info
  schemaCacheUpdatedAt DateTime?
  writeEnabled         Boolean   @default(false)
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  queryLogs            DataQueryLog[]

  @@index([userId])
  @@index([userId, type])
  @@index([orgId])
}

model DataQueryLog {
  id               String   @id @default(cuid())
  dataConnectionId String
  userId           String
  agentId          String?
  queryMode        String   // sql, natural_language
  originalQuery    String
  generatedSql     String?
  rowCount         Int?
  executionTimeMs  Int?
  creditsUsed      Float?
  status           String   // success, error
  error            String?
  createdAt        DateTime @default(now())
  dataConnection   DataConnection @relation(fields: [dataConnectionId], references: [id], onDelete: Cascade)

  @@index([dataConnectionId, createdAt])
  @@index([userId, createdAt])
}

// ── Feature: Collective Learning (Site Intelligence) ──────────────────────────

model SiteIntelligence {
  id             String   @id @default(cuid())
  domain         String   // z.B. "amazon.de"
  pathPattern    String   // z.B. "/dp/:id", "/s", "/"
  dataType       String   // "product_selector", "search_selector", "obstacle_selector", "page_pattern"
  selectorKey    String   // z.B. "title", "price", "cookieBanner"
  selectorValue  String   // z.B. "#productTitle", ".a-price .a-offscreen"
  successCount   Int      @default(1)
  failCount      Int      @default(0)
  confidence     Float    @default(0.5) // 0-1, steigt mit Erfolgen
  lastSeenAt     DateTime @default(now())
  lastFailedAt   DateTime?
  source         String   @default("execution") // "execution", "static_recipe", "manual"
  metadata       Json?    // Zusätzliche Infos (z.B. alternatives Selectors)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([domain, pathPattern, dataType, selectorKey])
  @@index([domain])
  @@index([domain, pathPattern])
  @@index([confidence])
  @@index([lastSeenAt])
}

// ── Feature: Swarm Intelligence (Learning from Executions) ──────────────────

model SwarmIntelligence {
  id                   String   @id @default(cuid())
  userId               String
  goalHash             String   // SHA-256 hash des normalisierten Goals
  goalSnippet          String   // Erste 200 Zeichen des Goals (für Dashboard)
  taskType             String   // research, comparison, analysis, etc.
  scope                String   // narrow, medium, wide
  complexity           String   // low, medium, high
  agentCount           Int      // Anzahl der Sub-Agents
  decompositionConfig  Json     // { maxTasks, phases, specializations[], tools[] }
  promptVersionHash    String   // Hash der verwendeten System-Prompts
  toolsUsed            String[] // ["web_search", "computer_use", ...]
  mergeStrategy        String   // wait_all, synthesize, etc.

  // Ergebnis-Metriken
  qualityScore         Float    // 0-1 aus Quality Gate
  userSignal           Int?     // +1 = thumbs up, -1 = thumbs down, null = kein Feedback
  executionTimeMs      Int
  creditsUsed          Float
  agentResults         Json     // [{ id, specialization, qualityScore, toolCalls, stoppedReason }]
  conflictCount        Int      @default(0)
  sourcesFound         Int      @default(0)
  errorCount           Int      @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([goalHash])
  @@index([taskType, qualityScore])
  @@index([userId, createdAt])
  @@index([promptVersionHash])
  @@index([createdAt])
}

/// ── Phase 2.3b: Sub-Org Hierarchy (Agency-Tier) ─────────────────────────
///
/// An Agency org can own one or more Sub-Orgs ("Client workspaces"). Both
/// the parent and the child are real Clerk Organizations — this table
/// records the parent → child relationship so we can list an Agency's
/// sub-orgs, gate sub-org creation by plan tier, and route billing /
/// branding from the Agency down to each child.
model OrgRelationship {
  id           String       @id @default(cuid())
  parentOrgId  String       // Clerk Org ID of the Agency (parent)
  childOrgId   String       @unique // Clerk Org ID of the Sub-Org (child)
  createdAt    DateTime     @default(now())
  createdBy    String       // Clerk user id who created the relationship

  // Sub-Org metadata cached locally so the agency dashboard doesn't have
  // to round-trip Clerk for every list render.
  subOrgName   String
  subOrgStatus SubOrgStatus @default(ACTIVE)

  // Phase 3 — Stripe Connect pricing. Pricing is configured by the agency
  // and lives in the agency's connected Stripe account, not in KILN's
  // platform account. KILN takes no application fee (GHL model).
  //
  // Phase 4 splits the price IDs by purpose: a Stripe Subscription with a
  // setup fee is two prices on the same product — a recurring `monthly`
  // price + a one-time `setup` price added as a checkout line item. Trial
  // days delay the first charge of the recurring price, but the setup fee
  // is charged immediately.
  pricingMode          SubOrgPricingMode @default(NONE)
  monthlyPriceCents    Int?
  setupFeeCents        Int?
  pricingCurrency      String?           @default("eur")
  trialDays            Int?
  stripeProductId      String?
  stripeMonthlyPriceId String?
  stripeSetupPriceId   String?

  // Customer onboarding wizard metadata. This table is the repo's
  // canonical Sub-Org record, so onboarding fields live here rather than
  // on a separate SubOrg model.
  industry             String?
  onboardedVia         OnboardingMethod @default(MANUAL)
  onboardingDuration   Int?
  onboardedAt          DateTime?
  brandColor           String?
  logoUrl              String?
  customSubdomain      String?
  emailSignature       String?

  // Phase 5 — Per-Sub-Org email branding override (Json bag). When set,
  // wins over the parent agency's OrgBranding for emails sent in this
  // sub-org's context. Shape: EmailBrandOverride in src/lib/email/types.
  emailBrandOverride   Json?

  @@index([parentOrgId])
  @@index([childOrgId])
  @@index([parentOrgId, subOrgStatus])
  @@index([parentOrgId, industry])
}

model AgencyOpsSnapshot {
  id                  String   @id @default(cuid())
  agencyOrgId          String

  totalCustomers       Int
  activeDepartments    Int
  pendingApprovals     Int
  failedRuns24h        Int
  tokensUsedToday      Int
  revenueToday         Float

  customerHealth       Json
  computedAt           DateTime @default(now())

  @@unique([agencyOrgId, computedAt])
  @@index([agencyOrgId, computedAt])
}

enum OnboardingMethod {
  MANUAL
  WIZARD
  API
}

model IndustryTemplate {
  id                  String   @id @default(cuid())
  industry            String   @unique
  displayName         String
  displayNameDe       String?
  description         String   @db.Text
  descriptionDe       String?  @db.Text

  departmentTemplates Json
  knowledgeBaseSeeds  Json?
  recommendedChannels Json
  metadata            Json?

  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  iconName            String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model OnboardingWizard {
  id               String   @id @default(cuid())
  agencyOrgId       String
  userId           String
  status           String   @default("DRAFT")
  currentStep      Int      @default(1)

  basics           Json     @default("{}")
  selectedTemplates Json    @default("[]")
  knowledgeConfig  Json     @default("{}")
  channelConfig    Json     @default("{}")
  brandingConfig   Json     @default("{}")

  activationResult Json?
  progress         Json?
  error            String?  @db.Text
  subOrgId         String?

  startedAt        DateTime @default(now())
  activatedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agencyOrgId, status])
  @@index([userId, updatedAt])
  @@index([expiresAt])
}

enum SubOrgStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// How a sub-org is billed by its parent agency. NONE = free,
/// FIXED = recurring Stripe subscription via the agency's connected account,
/// CUSTOM = the agency invoices the client outside of KILN.
enum SubOrgPricingMode {
  NONE
  FIXED
  CUSTOM
}

/// White-label branding configured by an Agency org. The agency sees its
/// own brand on its dashboard; sub-orgs inherit it (logo + agencyName
/// shown in the sidebar, optional primary color override). One row per
/// Clerk Org.
model OrgBranding {
  id             String   @id @default(cuid())
  orgId          String   @unique // Clerk Org ID
  logoUrl        String?
  primaryColor   String?  // hex, e.g. #F97316
  showAgencyLogo Boolean  @default(true)
  agencyName     String?
  emailSignature String?  @db.Text

  // Custom Domain — Phase 2.3c. The agency points a hostname (e.g.
  // kunde-portal.agentur.de) at our Vercel deployment via CNAME, and
  // every request to that hostname renders this org's workspace.
  // Verification flips to true once Vercel confirms SSL provisioning;
  // unverified domains are NOT routed (middleware checks both fields).
  customDomain     String?  @unique
  domainVerified   Boolean  @default(false)
  domainVerifiedAt DateTime?

  // Phase 5 — White-label email branding. logoUrl, primaryColor and
  // agencyName above are reused as the visual identity; these add the
  // From-address, footer and support link that emails need.
  emailFromAddress String?  // e.g. "support@hephaistos.de" — must be verified in Resend
  emailFromName    String?  // e.g. "Hephaistos Support"
  emailReplyTo     String?
  emailFooterHtml  String?  @db.Text
  emailSupportLink String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customDomain])
}

/// Phase 3 — Stripe Connect Express account owned by an agency. One row per
/// agency org. Onboarding kicks off Stripe-hosted KYC/payout setup; we
/// mirror the relevant readiness flags here so the dashboard can render
/// status without a round-trip to Stripe on every page load.
model AgencyStripeAccount {
  id                 String    @id @default(cuid())
  orgId              String    @unique // Clerk Org ID of the agency
  stripeAccountId    String    @unique // acct_xxx

  onboardingComplete Boolean   @default(false)
  detailsSubmitted   Boolean   @default(false)
  payoutsEnabled     Boolean   @default(false)
  chargesEnabled     Boolean   @default(false)

  // Currently/eventually due requirements + last sync timestamp. We refresh
  // this on demand (manual button + on relevant webhook events).
  requirementsJson   Json?
  lastSyncedAt       DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Phase 3 — A sub-org's active subscription, billed by the parent agency
/// through Stripe Connect. Customer + subscription IDs live in the agency's
/// connected account; we cache the readable snapshot locally for revenue
/// dashboards and gating.
model SubOrgSubscription {
  id                   String             @id @default(cuid())
  subOrgId             String             @unique // Clerk Org ID
  parentAgencyOrgId    String             // Clerk Org ID

  stripeSubscriptionId String             @unique // sub_xxx (in connected acct)
  stripeCustomerId     String             // cus_xxx (in connected acct)
  stripePriceId        String             // price_xxx (in connected acct)
  stripeProductId      String?

  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  // Snapshot of the price at subscription time so the agency can adjust
  // pricing later without rewriting historical revenue.
  priceAmount          Int                // cents
  priceCurrency        String             @default("eur")
  priceInterval        String             @default("month")

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([parentAgencyOrgId])
  @@index([status])
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

/// Phase 3 — Cached snapshot of a paid invoice on a sub-org subscription.
/// Sources from the connected account's invoice events. Used to compute
/// trailing-90-day revenue without re-paginating Stripe.
model SubOrgInvoice {
  id                String      @id @default(cuid())
  subOrgId          String
  parentAgencyOrgId String

  stripeInvoiceId   String      @unique // in_xxx (in connected acct)
  amount            Int         // cents
  currency          String      @default("eur")
  status            String      // paid, open, void, uncollectible
  // Phase 4 — distinguishes one-time setup-fee invoices from recurring
  // monthly subscription invoices so the agency revenue dashboard can
  // split MRR from one-shot setup revenue.
  invoiceType       InvoiceType @default(SUBSCRIPTION)

  invoiceDate       DateTime
  paidAt            DateTime?

  pdfUrl            String?
  hostedInvoiceUrl  String?

  createdAt         DateTime    @default(now())

  @@index([parentAgencyOrgId, invoiceDate])
}

/// Phase 4 — invoice categorization for sub-org revenue split. SETUP_FEE
/// = one-time setup invoice; SUBSCRIPTION = recurring monthly bill;
/// ADD_ON reserved for future per-seat / overage charges.
enum InvoiceType {
  SUBSCRIPTION
  SETUP_FEE
  ADD_ON
}
