// ── Feature 1: Approval Workflows ──────────────────────────────

enum WorkflowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
  AUTO_APPROVED
  EXPIRED
}

model WorkflowApproval {
