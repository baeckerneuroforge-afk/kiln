// ── Knowledge Graph ──────────────────────────────────────────

model KnowledgeEntity {
  id         String   @id @default(cuid())
  userId     String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  type       String   // Company, Person, Product, Website, Price, Event, Document, Insight
  name       String
  properties Json     // Freiform-Eigenschaften
  sources    Json     // Array of { agentId, executionId, timestamp }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  relationsFrom KnowledgeRelation[] @relation("RelationFrom")
  relationsTo   KnowledgeRelation[] @relation("RelationTo")
  events        KnowledgeEvent[]

  @@unique([userId, type, name])
  @@index([userId, type])
  @@index([userId])
  @@index([orgId])
}

model KnowledgeRelation {
  id                String   @id @default(cuid())
  userId            String
  fromEntityId      String
  fromEntity        KnowledgeEntity @relation("RelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntityId        String
  toEntity          KnowledgeEntity @relation("RelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  relationType      String   // has_product, employs, competes_with, changed_price, mentioned_in, located_at, sells
  properties        Json?
  sourceAgentId     String?
  sourceExecutionId String?
  createdAt         DateTime @default(now())

  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([userId])
}

model KnowledgeEvent {
  id                String   @id @default(cuid())
  entityId          String
  entity            KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  eventType         String   // created, updated, price_changed, relation_added
  previousValue     Json?
  newValue          Json?
  sourceAgentId     String?
  sourceExecutionId String?
  createdAt         DateTime @default(now())

  @@index([entityId])
  @@index([entityId, createdAt])
}

