generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// pgvector-backed RAG embeddings table. Managed entirely by the Supabase
/// migrations under supabase/migrations/. Stubbed here with @@ignore so
/// `prisma migrate diff` doesn't propose DROP TABLE on every run, while
/// keeping schema management out of Prisma's hands. The vector column uses
/// Unsupported() because Prisma has no first-class pgvector type — DO NOT
/// attempt to read/write this table via Prisma; use the Supabase admin
/// client (getSupabaseAdmin()) instead.
model knowledge_chunks {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  knowledge_base_id String
  agent_id          String
  content           String
  embedding         Unsupported("vector")?
  chunk_index       Int                    @default(0)
  created_at        DateTime?              @default(now()) @db.Timestamptz(6)
  org_id            String?

  @@ignore
}

// Clerk-synchronisierte User-Daten
model User {
  id               String   @id // Clerk User ID
  email            String   @unique
  firstName        String?
  lastName         String?
  imageUrl         String?
  // Clerk Organization ID for the user's auto-created Personal workspace.
  // Populated by the user.created webhook or the backfill script. All
  // user-owned data created before Clerk Organizations were enabled is
  // mapped to this org during backfill.
  personalOrgId    String?  @unique
  plan             Plan     @default(FREE)
  stripeCustomerId String?  @unique
  companyName      String?
  advancedMode          Boolean  @default(false)
  onboardingCompleted   Boolean  @default(false)
  onboardingState       Json?
  referralCode     String?  @unique // KILN-XXXX
  referredBy       String?  // userId des Referrers
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  aiCreditsBalance   Int       @default(50)
  aiCreditsMonthly   Int       @default(50)  // allocated per plan+tier
  aiCreditsResetDate DateTime?
  creditTier         Int       @default(0)   // 0=base, 1=mid, 2=high within each plan
  emailNotifications Boolean   @default(true)
  tourCompleted         Boolean  @default(false)
  lastSeenChangelog     String?  // ISO date of last seen changelog entry
  weeklyReportEnabled Boolean  @default(true)
  enableTrendAlerts   Boolean  @default(true)

  agents              Agent[]
  conversations       Conversation[]
  referralCredits     ReferralCredit[]
  marketplaceTemplates MarketplaceTemplate[]
  agentTeams          AgentTeam[]
  departments         Department[]
  teamExecutions      TeamExecution[]
  creditUsage         AiCreditUsage[]
  quickUseTasks       QuickUseTask[]
  quickUseMemories    QuickUseMemory[]
}

// Referral Credits — tracks rewards for referrers
model ReferralCredit {
  id             String   @id @default(cuid())
  userId         String   // Der Referrer, der den Credit bekommt
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredUserId String   // Wer hat sich angemeldet
  referredEmail  String?
  type           String   // "SIGNUP" | "UPGRADE_PRO" | "UPGRADE_AGENCY"
  applied        Boolean  @default(false) // Stripe Coupon angewendet?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([orgId])
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
  AGENCY
  ENTERPRISE
}

enum ModelProvider {
  ANTHROPIC
  OPENAI
  PERPLEXITY
  GOOGLE
  GROQ
}

enum CreditUsageType {
  CHAT
  TEAM_TASK
  ORCHESTRATION
  SCHEDULED
  WEBHOOK
  EMBEDDING
  TASK_RUN
}

// AI Agent Konfiguration
model Agent {
  id                 String        @id @default(cuid())
  userId             String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  slug               String        @unique
  description        String?       @db.Text
  systemPrompt       String        @db.Text
  personality        Json?         // { tone, language, formality }
  welcomeMessage     String?       @db.Text
  suggestedQuestions String[]      // Array von Vorschlägen
  llmModel           String        @default("claude-sonnet-4-20250514")
  temperature        Float         @default(0.7)
  modelProvider      ModelProvider @default(ANTHROPIC)
  status             AgentStatus   @default(DRAFT)
  visibility         AgentVisibility @default(PUBLIC) @map("agentType")
  mode               AgentMode       @default(CHAT)   @map("agentMode")

  // Task Agent fields
  triggerType        TriggerType @default(MANUAL)
  triggerConfig      Json?       // { cron, webhookPath, sourceAgentId }
  preProcessConfig   Json?       // { enabled, code, conditions: [{field,op,value,action}] }
  postProcessConfig  Json?       // { enabled, code, conditions: [{field,op,value,action}], branches: [{name,condition,outputType,outputConfig}] }
  outputType         OutputType  @default(NONE)
  outputConfig       Json?       // { url, email, targetAgentId, code }
  lastRunAt          DateTime?
  lastRunResult      Json?

  // Action Agent I/O typing — JSON Schema describing expected input / produced output.
  // Both nullable: agents without schemas are passthrough (no validation).
  inputSchema        Json?
  outputSchema       Json?
  // When true, output validation failures are 4xx errors instead of warnings.
  strictOutputValidation Boolean @default(false)

  // White-Label
  whiteLabel         Json?       // { logo, primaryColor, position, customCss }
  customDomain       String?
  showPoweredBy      Boolean     @default(true)

  // ROI-Berechnung
  avgDealValue       Float?      // Durchschnittlicher Deal-Wert in EUR

  // Auto-detect visitor language and respond in the same language
  autoDetectLanguage Boolean     @default(true)

  // Persistent Memory
  memoryEnabled      Boolean     @default(false)
  visitorMemoryEnabled Boolean   @default(true)

  // Multimodal — Bildanalyse
  imageAnalysisEnabled Boolean   @default(false)
  imageAutoActions     Boolean   @default(false)

  // AI Transparency — EU AI Act compliance
  showAiDisclaimer   Boolean     @default(true)

  // Prompt Branching — conditional prompt snippets
  promptBranches     Json?       // [{ name, keywords[], promptSnippet, enabled }]

  // Agentic RAG — self-learning via web research
  enableAgenticRag          Boolean     @default(false)
  agenticRagAutoApprove     Boolean     @default(false)
  agenticRagMinConfidence   Int         @default(90)

  // A2A Protocol — Agent-to-Agent communication
  a2aEnabled         Boolean     @default(false)
  a2aCapabilities    String[]    // z.B. ["lead_qualification", "appointment_booking"]
  a2aConnectedAgents Json?       // [{ url, name, lastPing }]
  a2aApiKey          String?     @unique // Unique API key for inbound A2A calls
  a2aCreditCost      Int         @default(1) // Credits pro A2A Call
  a2aCategory        String?     // Sales, Support, Booking, Research, Data Processing
  a2aUsageCount      Int         @default(0)
  a2aAvgResponseMs   Int         @default(0)
  a2aRating          Float       @default(0) // 0-5

  // Enterprise Memory — Cross-Agent Business Intelligence
  enableEnterpriseMemory Boolean @default(true)

  // Team-Based Intent Routing
  teamRoutingEnabled Boolean     @default(false)
  teamRoutingTeamId  String?     // AgentTeam ID for intent-based routing

  // Code Execution — Sandbox für Python/JavaScript
  codeExecutionEnabled Boolean   @default(false)

  // Clone-Tracking
  clonedFromId         String?   // ID des Original-Agents (falls geklont)
  clonedFromName       String?   // Name des Originals zum Zeitpunkt des Klonens

  // Budget Controls
  maxCreditsPerRun      Int?      // Max credits per single execution (null = unlimited)
  maxCostPerRunCents    Int?      // Legacy: Max cost per run in cents (null = unlimited)
  monthlyCostCapCents   Int?      // Legacy: Max monthly cost in cents (null = unlimited, plan credits handle this now)
  budgetExceededBehavior String?  // "pause" | "downgrade" | "notify_continue"

  // Approval Workflows — Human-in-the-Loop
  approvalMode       String    @default("none") // "none" | "critical_only" | "all_actions" | "custom"
  approvalConfig     Json?     // { checklist: string[], autoApproveTimeoutMinutes: number, approverEmail: string, notificationChannel: string }

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  actions        AgentAction[]
  customTools    AgentCustomTool[]
  knowledgeBases KnowledgeBase[]
  conversations  Conversation[]
  analytics      AgentAnalytics[]
  memories       AgentMemory[]
  visitorMemories VisitorMemory[]
  automations    AutomationRule[]
  versions       AgentVersion[]
  testCases      AgentTestCase[]
  testRuns       AgentTestRun[]
  testComparisons TestComparison[]
  orchestrationsFrom AgentOrchestration[] @relation("OrchestrationSource")
  orchestrationsTo   AgentOrchestration[] @relation("OrchestrationTarget")
  webhooks           AgentWebhook[]
  integrations       AgentIntegration[]
  channels           AgentChannel[]
  teamMembers        TeamMember[]
  agentTeamMembers   AgentTeamMember[] @relation("AgentTeamMembers")
  fallbackForMembers AgentTeamMember[] @relation("TeamFallbackAgent")
  teamExecutionLogs  TeamExecutionLog[]
  runs               AgentRun[]
  researchEntries    AgentResearchEntry[]
  a2aLogs            A2AInteractionLog[]
  credentials        AgentCredential[]
  codeSandboxSessions  CodeSandboxSession[]
  proceduralMemories   ProceduralMemory[]
  watchLearnSessions   WatchLearnSession[]
  apiDiscoveries       ApiDiscovery[]
  modelRoutingConfig   ModelRoutingConfig?
  costRecords          CostRecord[]
  mcpConnections       MCPConnection[]
  roiConfig            ROIConfig?
  workflowApprovals    WorkflowApproval[]
  departmentWorker     DepartmentWorker[] @relation("DepartmentWorker")
  departmentManagedBy  Department[]       @relation("DepartmentManager")

  @@index([userId])
  @@index([orgId])
}

enum AgentVisibility {
  PUBLIC
  INTERNAL

  @@map("AgentType")
}

enum AgentMode {
  CHAT
  TASK
}

enum TriggerType {
  MANUAL
  SCHEDULE
  WEBHOOK
  EVENT
  FOLLOWUP
}

enum OutputType {
  NONE
  HTTP_REQUEST
  EMAIL
  NEXT_AGENT
  WEBHOOK
  CUSTOM_CODE
}

enum RunStatus {
  SUCCESS
  ERROR
}

enum AgentStatus {
  DRAFT
  LIVE
  PAUSED
}

// Agent Actions (Terminbuchung, E-Mail, Lead-Scoring, etc.)
model AgentAction {
  id      String     @id @default(cuid())
  agentId String
  agent   Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type    ActionType
  enabled Boolean    @default(false)
  config  Json?      // { calendlyUrl, emailTemplate, webhookUrl, etc. }

  @@unique([agentId, type])
  @@index([agentId])
}

enum ActionType {
  BOOK_APPOINTMENT
  COLLECT_EMAIL
  SEND_EMAIL
  SCORE_LEAD
  NOTIFY_OWNER
  FIRE_WEBHOOK
  HANDOFF_HUMAN
  CUSTOM_CODE
  HTTP_REQUEST
}

// Custom HTTP Tools — benutzerdefinierte API-Integrationen
model AgentCustomTool {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name            String   // Tool-Name für Claude (snake_case)
  description     String   @db.Text // Wann Claude das Tool nutzen soll
  method          String   @default("GET") // GET, POST, PUT, DELETE
  url             String   // Endpoint URL mit {{variable}} Platzhaltern
  headers         Json?    // { "Authorization": "Bearer xxx", ... }
  bodyTemplate    String?  @db.Text // JSON body template mit {{variable}} Platzhaltern
  responseMapping String?  // JSON-Pfad zum Ergebnis (z.B. "data.results[0].name")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentId])
}

// Knowledge Base Einträge
model KnowledgeBase {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id              String      @id @default(cuid())
  agentId         String?
  agent           Agent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  teamId          String?
  team            AgentTeam?  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type            KBType
  sourceName      String
  content         String      @db.Text
  chunkCount      Int         @default(0)
  embeddingStatus EmbedStatus @default(PENDING)

  createdAt DateTime @default(now())

  departments     Department[]

  @@index([agentId])
  @@index([teamId])
  @@index([orgId])
}

enum KBType {
  PDF
  URL
  FAQ
  TEXT
}

enum EmbedStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

// Chat-Konversationen
model Conversation {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId      String?
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  user        User?    @relation(fields: [userId], references: [id])
  sessionId   String
  leadScore   Int?
  sentiment   Float?
  actionsUsed String[]
  channel     Channel  @default(WEB)

  visitorName  String?
  visitorEmail String?

  // Human Handoff tracking
  handoffStatus HandoffStatus?

  // Agent Handoff: when conversation is transferred to another agent
  handoffAgentId  String?
  handoffAt       DateTime?

  // Intent-Based Routing
  lastDetectedIntent  String?     // Last classified intent (e.g., "pricing", "support")
  lastIntentAgentId   String?     // Agent ID the intent was routed to

  // Image Vision V1.0
  extractedDocuments  Json?       // [{ type, fields, imageUrl }]
  imageComparisonMode String?     // "before_after" | null

  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([sessionId])
  @@index([orgId])
}

// Chat-Nachrichten
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           MessageRole
  content        String  @db.Text
  imageUrl       String? @db.Text
  extractedData  Json?   // Structured data from OCR/document analysis

  createdAt DateTime @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  HUMAN
}

enum HandoffStatus {
  REQUESTED
  RESPONDED
}

enum Channel {
  WEB
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  VOICE
  SLACK
  EMAIL
  GITHUB
}

// Gesammelte Leads
model Lead {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id        String   @id @default(cuid())
  agentId   String
  email     String
  name      String?
  context   String?  @db.Text // Gesprächskontext, warum der Lead interessiert ist
  score     Int?     // Lead-Score 1-10
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([email])
  @@index([orgId])
}

// Agent Memory — persistent user memories across conversations
model AgentMemory {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workflowExecutionId String?
  scope       MemoryScope @default(AGENT)
  sessionHash String   // Hash des sessionId — identifiziert wiederkehrende Besucher
  key         String   // z.B. "name", "preference", "question_asked"
  value       String   @db.Text
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([agentId, sessionHash, key])
  @@index([agentId, sessionHash])
  @@index([workflowExecutionId])
  @@index([scope])
  @@index([orgId])
}

// Visitor Memory — persistent visitor profiles with enriched context
model VisitorMemory {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id                String   @id @default(cuid())
  agentId           String
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  visitorId         String   // Browser fingerprint or stable identifier
  displayName       String?  // Gesammelter Name (aus Gespräch oder COLLECT_EMAIL)
  email             String?  // Gesammelte E-Mail (aus COLLECT_EMAIL)
  memoryContext     Json     @default("{}") // LLM-extrahierte Fakten: { interests, questions, stage, objections, ... }
  tags              String[] // z.B. ["interested-in-pro", "asked-about-pricing"]
  conversationCount Int      @default(0)
  firstVisitAt      DateTime @default(now())
  lastVisitAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([agentId, visitorId])
  @@index([agentId])
  @@index([agentId, email])
  @@index([orgId])
}

// API Access Keys — programmatischer Zugang zu KILN API
model ApiAccessKey {
  id         String    @id @default(cuid())
  userId     String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  name       String    // z.B. "Production Key", "Dev Key"
  hashedKey  String    @unique // SHA-256 Hash des Keys
  keyPrefix  String    // "sk-kiln-xxxx" — letzte 4 Zeichen für Anzeige
  scopes     Json      @default("[\"admin\"]")
  expiresAt  DateTime?
  lastUsed   DateTime?
  createdAt  DateTime  @default(now())

  usages     ApiAccessKeyUsage[]

  @@index([userId])
  @@index([hashedKey])
  @@index([expiresAt])
  @@index([orgId])
}

model ApiAccessKeyUsage {
  id             String       @id @default(cuid())
  keyId          String
  key            ApiAccessKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  endpoint       String
  method         String
  responseStatus Int
  createdAt      DateTime     @default(now())

  @@index([keyId])
  @@index([createdAt])
  @@index([keyId, createdAt])
  @@index([endpoint])
}

// API Keys — Bring Your Own Key (verschlüsselt gespeichert)
model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  provider     String   // "anthropic" | "openai"
  encryptedKey String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([orgId])
}

// Agent Analytics (täglich aggregiert)
model AgentAnalytics {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id                 String   @id @default(cuid())
  agentId            String
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  totalConversations Int      @default(0)
  avgMessagesPerConv Float    @default(0)
  leadsCollected     Int      @default(0)
  appointmentsBooked Int      @default(0)
  estimatedValue     Float    @default(0)
  topIntents         Json?

  @@unique([agentId, date])
  @@index([agentId])
  @@index([orgId])
}

// Scheduled Automations — proaktive Agent-Tasks per Cron
model AutomationRule {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id                   String    @id @default(cuid())
  agentId              String
  agent                Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name                 String
  cronExpression       String    // z.B. "0 * * * *" (stündlich)
  taskDescription      String    @db.Text
  notificationMethod   String    @default("NONE") // "NONE" | "EMAIL" | "WEBHOOK"
  notificationTarget   String?   // E-Mail-Adresse oder Webhook-URL
  enabled              Boolean   @default(true)
  lastRunAt            DateTime?
  lastRunResult        String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([agentId])
  @@index([enabled])
  @@index([orgId])
}

// Agent Version History — Config-Snapshots bei jedem Speichern
model AgentVersion {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version   Int
  config    Json     // Snapshot of the saved agent configuration for rollback and comparison
  changelog String   @db.Text
  createdAt DateTime @default(now())
  createdBy String

  @@unique([agentId, version])
  @@index([agentId])
  @@index([orgId])
}

// Workflow Version History — Snapshot bei jedem Workflow-Speichern
model TeamVersion {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id        String   @id @default(cuid())
  teamId    String
  team      AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  version   Int
  config    Json     // Full workflow snapshot: nodes, edges, variables, teamConfig
  changelog String   @db.Text
  note      String?  @db.Text  // Optional user note when saving
  createdAt DateTime @default(now())
  createdBy String

  @@unique([teamId, version])
  @@index([teamId])
  @@index([orgId])
}

// Agent Test Cases — Eval-Suite für Agent-Antworten
model AgentTestCase {
  id               String    @id @default(cuid())
  agentId          String
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name             String
  inputMessage     String    @db.Text
  expectedKeywords Json      // String-Array: ["keyword1", "keyword2"]
  lastResult       String?   // "PASS" | "FAIL" | null
  lastResponse     String?   @db.Text
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([agentId])
}

// Agent Test Runs — Aggregierte Ergebnisse pro Testlauf
model AgentTestRun {
  id         String   @id @default(cuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  totalTests Int
  passed     Int
  failed     Int
  score      Float    // 0.0 bis 1.0
  runAt      DateTime @default(now())

  @@index([agentId])
}

enum TestComparisonWinner {
  A
  B
  SAME
}

model TestComparison {
  id              String                @id @default(cuid())
  agentId         String
  agent           Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  message         String                @db.Text
  responseA       String                @db.Text
  responseB       String                @db.Text
  configA         Json
  configB         Json
  winner          TestComparisonWinner?
  responseTimeA   Int?
  responseTimeB   Int?
  tokenCountA     Int?
  tokenCountB     Int?
  createdAt       DateTime              @default(now())

  @@index([agentId, createdAt])
}

// Webhook Endpoints — Event-Benachrichtigungen per HTTP POST
model WebhookEndpoint {
  id         String     @id @default(cuid())
  userId     String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  agentId    String?    // Optional: agent-spezifische Subscriptions
  teamId     String?    // Optional: team-spezifische Subscriptions
  team       AgentTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  url        String
  events     Json       // String-Array: ["team.execution.started", ...]
  secret     String     // HMAC-SHA256 Signing Secret
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())

  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([agentId])
  @@index([teamId])
  @@index([active])
  @@index([orgId])
}

// Webhook Delivery Log — Zustellungsprotokoll
model WebhookDelivery {
  id           String          @id @default(cuid())
  webhookId    String
  webhook      WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  statusCode   Int?
  responseTime Int?            // ms
  success      Boolean
  error        String?
  createdAt    DateTime        @default(now())

  @@index([webhookId])
}

// Agent Orchestration — agent-to-agent handoff rules
model AgentOrchestration {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id              String   @id @default(cuid())
  sourceAgentId   String
  sourceAgent     Agent    @relation("OrchestrationSource", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  targetAgentId   String
  targetAgent     Agent    @relation("OrchestrationTarget", fields: [targetAgentId], references: [id], onDelete: Cascade)
  condition       String   @db.Text // Keyword oder Bedingung für Handoff
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  handoffs        OrchestrationHandoff[]

  @@index([sourceAgentId])
  @@index([targetAgentId])
  @@index([orgId])
}

// Orchestration Handoff Log — records each agent-to-agent handoff
model OrchestrationHandoff {
  id                    String   @id @default(cuid())
  orchestrationRuleId   String
  orchestrationRule     AgentOrchestration @relation(fields: [orchestrationRuleId], references: [id], onDelete: Cascade)
  sourceAgentId         String
  targetAgentId         String
  conversationId        String
  reason                String   @db.Text // Why the handoff was triggered
  createdAt             DateTime @default(now())

  @@index([orchestrationRuleId])
  @@index([sourceAgentId])
  @@index([conversationId])
}

// Integration Connections — third-party service connections
model IntegrationConnection {
  id        String   @id @default(cuid())
  userId    String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  provider  String   // "google-calendar", "slack", "hubspot", etc.
  name      String   // Display name (auto or custom)
  config    String   @db.Text // Encrypted JSON: { apiKey, webhookUrl, etc. }
  isActive  Boolean  @default(true)
  isCustom  Boolean  @default(false) // Custom integrations via Advanced Mode
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentIntegrations AgentIntegration[]

  @@unique([userId, provider])
  @@index([userId])
  @@index([orgId])
}

// Per-Agent Integration assignment
model AgentIntegration {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  integrationId   String
  integration     IntegrationConnection @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true)
  config          String?  @db.Text // Per-agent integration config (JSON)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())

  @@unique([agentId, integrationId])
  @@index([agentId])
  @@index([integrationId])
}

// Agent Channels — Telegram, Email, WhatsApp, Slack connections
model AgentChannel {
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  id        String      @id @default(cuid())
  agentId   String
  agent     Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      ChannelType
  config    String      @db.Text // Encrypted JSON: { botToken, chatId, etc. }
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([agentId, type])
  @@index([agentId])
  @@index([orgId])
}

enum ChannelType {
  TELEGRAM
  EMAIL
  WHATSAPP
  SLACK
  GITHUB
  STRIPE
  AIRTABLE
  CALENDLY
}

// Team Members — access control for internal agents
model TeamMember {
  id         String          @id @default(cuid())
  agentId    String
  agent      Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  email      String
  role       TeamMemberRole  @default(VIEWER)
  invitedAt  DateTime        @default(now())
  acceptedAt DateTime?

  @@unique([agentId, email])
  @@index([agentId])
  @@index([email])
}

enum TeamMemberRole {
  VIEWER
  EDITOR
}

// Marketplace Templates — published agent templates
model MarketplaceTemplate {
  id                  String   @id @default(cuid())
  authorId            String
  author              User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName          String
  name                String
  description         String   @db.Text
  longDescription     String?  @db.Text
  category            String   // sales, support, research, monitoring, e-commerce, recruiting, marketing, legal
  price               Float    @default(0) // 0 = Free, otherwise EUR amount
  pricingType         String   @default("free") // free, one_time, monthly
  agentConfigSnapshot Json     // Sanitized agent config
  workflowConfig      Json?    // Optional workflow blueprint
  proceduralMemories  Json?    // Pre-trained procedural memories
  mcpConnections      Json?    // Required MCP connections listed
  demoConversation    Json?    // Example chat showing agent in action
  screenshots         Json?    // Array of screenshot URLs
  rating              Float    @default(0)
  ratingCount         Int      @default(0)
  downloads           Int      @default(0)
  installCount        Int      @default(0)
  screenshotUrl       String?
  tags                String[] // Searchable tags
  isApproved          Boolean  @default(true)
  status              String   @default("published") // draft, pending_review, published, rejected
  requiredPlan        String   @default("free") // free, starter, pro, business
  creatorAvatar       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchases MarketplacePurchase[]
  ratings   MarketplaceRating[]
  reviews   MarketplaceReview[]

  @@index([authorId])
  @@index([category])
  @@index([downloads])
  @@index([installCount])
  @@index([status])
}

// Marketplace Purchases — one-time template purchases
model MarketplacePurchase {
  id                String   @id @default(cuid())
  userId            String
  templateId        String
  template          MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stripePaymentId   String?
  amount            Float
  creatorRevenue    Float    @default(0) // 70% of amount
  platformRevenue   Float    @default(0) // 30% of amount
  createdAt         DateTime @default(now())

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
}

// Marketplace Ratings — user ratings for templates
model MarketplaceRating {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  template   MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rating     Int      // 1-5 stars
  createdAt  DateTime @default(now())

  @@unique([userId, templateId])
  @@index([templateId])
}

// Marketplace Reviews — text reviews for templates
model MarketplaceReview {
  id         String   @id @default(cuid())
  templateId String
  template   MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String
  userName   String
  rating     Int      // 1-5 stars
  reviewText String?  @db.Text
  createdAt  DateTime @default(now())

  @@unique([userId, templateId])
  @@index([templateId])
}

// Agent Inbound Webhooks — external services trigger agent processing
model AgentWebhook {
  id           String         @id @default(cuid())
  agentId      String
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  path         String         @unique // Unique URL path segment
  secret       String         // For HMAC validation
  httpMethods  Json           @default("[\"POST\"]") // Allowed methods
  authType     WebhookAuth    @default(NONE)
  authValue    String?        // Header token or HMAC secret
  responseMode ResponseMode   @default(IMMEDIATE)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  executions   WebhookExecution[]

  @@index([agentId])
  @@index([path])
}

enum WebhookAuth {
  NONE
  HEADER_AUTH
  HMAC
}

enum ResponseMode {
  IMMEDIATE
  AFTER_PROCESSING
}

// ── Agent Teams ─────────────────────────────────────────────

enum AgentTeamStatus {
  ACTIVE
  PAUSED
}

enum TeamExecutionStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  PARTIAL
  REJECTED
}

enum TeamExecutionTaskStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  SKIPPED
  REJECTED
}

enum AgentTeamRole {
  HEAD
  COORDINATOR
  EXECUTOR
  REPORTER
  APPROVAL_GATE
}

enum TeamPermissionRole {
  OWNER
  EDITOR
  VIEWER
  APPROVER
}

enum TeamPermissionStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum WorkflowVariableType {
  STRING
  NUMBER
  SECRET
  JSON
}

enum MemoryScope {
  AGENT
  WORKFLOW
  GLOBAL
}

enum WorkflowDeadLetterStatus {
  OPEN
  RETRIED
  DISCARDED
}

enum DepartmentType {
  CUSTOMER_SUPPORT
  SALES_OUTREACH
  LEAD_QUALIFICATION
  CONTENT_PRODUCTION
  RESEARCH
  CUSTOM
}

enum DepartmentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ApprovalMode {
  APPROVAL_FIRST
  AUTO
  OFF
}

enum BacklogStatus {
  PENDING
  CLAIMED
  RUNNING
  NEEDS_APPROVAL
  DONE
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ChannelMessageStatus {
  RECEIVED
  DRAFTED
  APPROVED
  SENT
  BLOCKED
  FAILED
}

enum NotifyChannel {
  SLACK_ONLY
  EMAIL_ONLY
  SLACK_THEN_EMAIL
  NONE
}

model AgentTeam {
  id            String          @id @default(cuid())
  userId        String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?         @db.Text
  goal          String?         @db.Text
  config        Json?
  status        AgentTeamStatus @default(ACTIVE)
  parentTeamId  String?         // Cloned/forked from this team
  isSubWorkflow Boolean         @default(false)
  parentWorkflowIds String[]    @default([])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  members        AgentTeamMember[]
  tasks          AgentTeamTask[]
  executions     TeamExecution[]
  executionLogs  TeamExecutionLog[]
  knowledgeBases KnowledgeBase[]
  webhooks       WebhookEndpoint[]
  permissions    TeamPermission[]
  versions       TeamVersion[]
  abTestsAsA     TeamABTest[]     @relation("ABTestTeamA")
  abTestsAsB     TeamABTest[]     @relation("ABTestTeamB")
  workflowVariables WorkflowVariable[]
  workflowComments  WorkflowComment[]
  deadLetters       WorkflowDeadLetter[]

  @@index([userId])
  @@index([orgId])
  @@index([isSubWorkflow])
}

model Department {
  id                  String           @id @default(cuid())
  userId              String
  orgId               String?          // Clerk Org ID, nullable during multi-tenancy migration
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?          @db.Text
  type                DepartmentType   @default(CUSTOMER_SUPPORT)
  status              DepartmentStatus @default(DRAFT)

  managerAgentId      String?
  managerSystemPrompt String?          @db.Text
  managerModel        String           @default("claude-sonnet-4-6")
  managerAgent        Agent?           @relation("DepartmentManager", fields: [managerAgentId], references: [id], onDelete: SetNull)

  approvalMode        ApprovalMode     @default(APPROVAL_FIRST)

  scheduleEnabled     Boolean          @default(false)
  scheduleCron        String?
  webhookEnabled      Boolean          @default(true)
  webhookSecret       String           @default(cuid())

  emailEnabled        Boolean          @default(false)
  emailInboundAddr    String?
  emailFromAddr       String?
  emailFromName       String?
  emailReplyToAddr    String?

  whatsappEnabled     Boolean          @default(false)
  whatsappPhoneId     String?
  whatsappBusinessId  String?

  notifyOnApprovalNeeded Boolean       @default(true)
  notifyChannel       NotifyChannel    @default(SLACK_THEN_EMAIL)
  notifySlackChannel  String?
  notifyEmailRecipients String?
  notifyDigestEnabled Boolean          @default(false)
  notifyDigestSentAt  DateTime?

  useKnowledgeBase    Boolean          @default(true)
  knowledgeBaseId     String?
  knowledgeBase       KnowledgeBase?   @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  operatingMemory     Json             @default("{}")
  totalTasks          Int              @default(0)
  totalApprovals      Int              @default(0)

  workerAgents        DepartmentWorker[]
  backlog             DepartmentBacklogItem[]
  runLogs             DepartmentRunLog[]
  channelMessages     DepartmentChannelMessage[]

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([userId])
  @@index([orgId, status])
  @@index([orgId, type])
}

model DepartmentWorker {
  id           String     @id @default(cuid())
  departmentId String
  agentId      String
  role         String
  description  String?    @db.Text
  priority     Int        @default(0)

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  agent        Agent      @relation("DepartmentWorker", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, agentId])
  @@index([departmentId])
  @@index([agentId])
}

model DepartmentBacklogItem {
  id              String        @id @default(cuid())
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  triggerType     TriggerType
  triggerPayload  Json

  status          BacklogStatus @default(PENDING)
  claimedAt       DateTime?
  completedAt     DateTime?

  result          Json?
  error           String?       @db.Text

  approvalDraft   Json?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?       @db.Text

  createdAt       DateTime      @default(now())

  channelMessages DepartmentChannelMessage[]

  @@index([departmentId, status])
  @@index([departmentId, createdAt])
}

model DepartmentRunLog {
  id              String     @id @default(cuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  backlogItemId   String?

  managerDecision Json
  workerInvoked   String?
  invocationType  String

  durationMs      Int
  tokensUsed      Int        @default(0)

  createdAt       DateTime   @default(now())

  @@index([departmentId, createdAt])
  @@index([backlogItemId])
}

model DepartmentChannelMessage {
  id                String               @id @default(cuid())
  departmentId      String
  backlogItemId     String?

  channel           ChannelType
  direction         MessageDirection

  emailMessageId    String?
  emailFrom         String?
  emailTo           String?
  emailSubject      String?
  emailHeaders      Json?
  emailBody         String?              @db.Text

  whatsappMessageId String?
  whatsappFrom      String?
  whatsappTo        String?
  whatsappBody      String?              @db.Text
  whatsappType      String?
  whatsappMediaId   String?

  status            ChannelMessageStatus @default(RECEIVED)
  blockedReason     String?              @db.Text
  errorMessage      String?              @db.Text

  sentAt            DateTime?
  externalId        String?

  createdAt         DateTime             @default(now())

  department        Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  backlogItem       DepartmentBacklogItem? @relation(fields: [backlogItemId], references: [id], onDelete: SetNull)

  @@index([departmentId, channel, createdAt])
  @@index([departmentId, direction, status])
  @@index([backlogItemId])
}

model TeamPermission {
  id          String               @id @default(cuid())
  teamId      String
  team        AgentTeam            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String?              // Clerk user ID, null until accepted
  email       String
  role        TeamPermissionRole
  status      TeamPermissionStatus @default(PENDING)
  inviteToken String?              @unique
  invitedAt   DateTime             @default(now())
  acceptedAt  DateTime?
  invitedBy   String               // userId of who invited

  @@index([teamId])
  @@index([userId])
  @@index([email])
  @@unique([teamId, email])
}

model AgentTeamMember {
  id                 String            @id @default(cuid())
  teamId             String
  team               AgentTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agentId            String?
  agent              Agent?            @relation("AgentTeamMembers", fields: [agentId], references: [id], onDelete: Cascade)
  fallbackAgentId    String?
  fallbackAgent      Agent?            @relation("TeamFallbackAgent", fields: [fallbackAgentId], references: [id], onDelete: SetNull)
  fallbackModel      String?
  fallbackEnabled    Boolean           @default(true)
  maxRetries         Int               @default(2)
  role               AgentTeamRole
  level              Int               @default(0) // 0 = top (HEAD), 1 = COORDINATOR, 2 = EXECUTOR/REPORTER
  responsibilities   String?           @db.Text
  config             Json?
  reportsToMemberId  String?
  reportsTo          AgentTeamMember?  @relation("TeamHierarchy", fields: [reportsToMemberId], references: [id])
  subordinates       AgentTeamMember[] @relation("TeamHierarchy")
  outputSchema       Json?             // Structured output schema: [{ field, type, description }]
  enabledActions     String[]          // Scoped actions for team context (empty = all agent actions)
  feedbackLoop       Json?             // { targetMemberId, maxIterations, qualityField, qualityThreshold }
  executionMode      String            @default("sequential") // "sequential" | "parallel"
  approvalRequests   ApprovalRequest[]
  createdAt          DateTime          @default(now())

  @@index([teamId])
  @@index([agentId])
  @@index([fallbackAgentId])
}

model AgentTeamTask {
  id           String    @id @default(cuid())
  teamId       String
  team         AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedToId String?   // AgentTeamMember ID
  title        String
  description  String?   @db.Text
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  priority     String    @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  result       String?   @db.Text
  parentTaskId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  executionLogs TeamExecutionLog[]

  @@index([teamId])
  @@index([assignedToId])
}

model TeamExecution {
  id             String              @id @default(uuid())
  teamId         String
  team           AgentTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId         String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           String?             @db.Text
  status         TeamExecutionStatus @default(RUNNING)
  priority       Int                 @default(2) // 0=CRITICAL, 1=HIGH, 2=NORMAL, 3=LOW
  queuedAt       DateTime?           // Set when status=QUEUED, null when processing
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  totalTasks     Int                 @default(0)
  completedTasks Int                 @default(0)
  failedTasks    Int                 @default(0)
  taskPlan       Json?
  executionContext Json?
  contextCompactions  Int     @default(0) // Wie oft der Context komprimiert wurde
  outputQualityScore  Float?              // 0-100 Qualitäts-Score des Outputs
  errorHandlingApplied Boolean @default(false)

  logs           TeamExecutionLog[]
  approvalRequests ApprovalRequest[]
  deadLetters    WorkflowDeadLetter[]

  @@index([teamId])
  @@index([userId])
  @@index([startedAt])
  @@index([orgId])
}

model TeamExecutionLog {
  id            String                  @id @default(cuid())
  teamId        String
  team          AgentTeam               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  executionId   String
  execution     TeamExecution           @relation(fields: [executionId], references: [id], onDelete: Cascade)
  taskId        String?
  task          AgentTeamTask?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskIndex     Int
  taskTitle     String
  agentId       String?
  agent         Agent?                  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  attempt       Int                     @default(1)
  status        TeamExecutionTaskStatus @default(PENDING)
  parallelGroup String?                 // Groups logs that ran in parallel
  nodeId        String?                 // Workflow node ID (for workflow executions)
  nodeType      String?                 // Workflow node type (trigger, logic, action, etc.)
  input         Json?
  output        String?                 @db.Text
  structuredOutput Json?                // Extracted JSON from agent output
  tokensIn      Int?                    // Input tokens used
  tokensOut     Int?                    // Output tokens generated
  model         String?                 // Model used for this task
  estimatedCost Float?                  // Cost in USD
  startedAt     DateTime?
  completedAt   DateTime?
  error         String?                 @db.Text

  @@index([teamId])
  @@index([executionId])
  @@index([taskId])
  @@index([agentId])
  @@index([executionId, taskIndex])
}

model ApprovalRequest {
  id              String                @id @default(cuid())
  teamExecutionId String
  teamExecution   TeamExecution         @relation(fields: [teamExecutionId], references: [id], onDelete: Cascade)
  gateMemberId    String?
  gateMember      AgentTeamMember?      @relation(fields: [gateMemberId], references: [id], onDelete: SetNull)
  taskIndex       Int
  token           String                @unique
  status          ApprovalRequestStatus @default(PENDING)
  approverEmail   String
  requestedAt     DateTime              @default(now())
  respondedAt     DateTime?
  respondedBy     String?
  note            String?               @db.Text

  @@index([teamExecutionId])
  @@index([gateMemberId])
  @@index([taskIndex])
}

model WorkflowVariable {
  id          String               @id @default(cuid())
  agentTeamId String
  agentTeam   AgentTeam            @relation(fields: [agentTeamId], references: [id], onDelete: Cascade)
  name        String
  value       String               @db.Text
  type        WorkflowVariableType
  isSecret    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([agentTeamId, name])
  @@index([agentTeamId])
}

model WorkflowDeadLetter {
  id             String                   @id @default(cuid())
  agentTeamId    String
  agentTeam      AgentTeam                @relation(fields: [agentTeamId], references: [id], onDelete: Cascade)
  teamExecutionId String?
  teamExecution  TeamExecution?          @relation(fields: [teamExecutionId], references: [id], onDelete: SetNull)
  nodeId         String
  nodeType       String
  payload        Json?
  error          String                   @db.Text
  attempts       Int                      @default(0)
  status         WorkflowDeadLetterStatus @default(OPEN)
  createdAt      DateTime                 @default(now())
  retriedAt      DateTime?
  discardedAt    DateTime?

  @@index([agentTeamId, status])
  @@index([teamExecutionId])
  @@index([nodeId])
}

model WorkflowComment {
  id           String    @id @default(cuid())
  agentTeamId  String
  agentTeam    AgentTeam @relation(fields: [agentTeamId], references: [id], onDelete: Cascade)
  content      String    @db.Text
  position     Json
  color        String    @default("yellow")
  authorUserId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([agentTeamId])
  @@index([authorUserId])
}

// ── Team A/B Testing ────────────────────────────────────────

enum TeamABTestStatus {
  RUNNING
  PAUSED
  COMPLETED
}

model TeamABTest {
  id                String           @id @default(cuid())
  userId            String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  name              String
  teamAId           String
  teamA             AgentTeam        @relation("ABTestTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamBId           String
  teamB             AgentTeam        @relation("ABTestTeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  splitPercentage   Int              @default(50) // Percentage routed to Team A
  metric            String           @default("completion_rate") // completion_rate, cost, speed, lead_quality
  status            TeamABTestStatus @default(RUNNING)
  maxExecutions     Int              @default(100)
  currentExecutions Int              @default(0)
  createdAt         DateTime         @default(now())
  completedAt       DateTime?

  results           TeamABTestResult[]

  @@index([userId])
  @@index([teamAId])
  @@index([teamBId])
  @@index([orgId])
}

model TeamABTestResult {
  id               String      @id @default(cuid())
  testId           String
  test             TeamABTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  teamExecutionId  String
  team             String      // "A" or "B"
  input            Json?
  result           String?     @db.Text
  status           String      // COMPLETED, FAILED, PARTIAL
  cost             Float?
  durationMs       Int?
  createdAt        DateTime    @default(now())

  @@index([testId])
  @@index([teamExecutionId])
}

// Webhook Execution Log — pipeline execution records
model WebhookExecution {
  id              String       @id @default(cuid())
  webhookId       String
  webhook         AgentWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  incomingPayload Json
  agentResponse   String?      @db.Text
  actionsExecuted Json?        // String array of executed action types
  duration        Int?         // ms
  statusCode      Int          @default(200)
  createdAt       DateTime     @default(now())

  @@index([webhookId])
}

// AI Credit Usage — tracks per-operation credit consumption
model AiCreditUsage {
  id             String          @id @default(cuid())
  userId         String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String?
  conversationId String?
  creditsUsed    Int
  model          String
  type           CreditUsageType @default(CHAT)
  createdAt      DateTime        @default(now())

  @@index([userId])
  @@index([agentId])
  @@index([userId, createdAt])
  @@index([type])
  @@index([orgId])
}

// Quick Use background tasks — persists execution state across tab close/reconnect
model QuickUseTask {
  id               String             @id @default(cuid())
  userId           String
  orgId            String?  // Clerk Org ID, nullable during multi-tenancy migration
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String             // "computer_use" | "agent_swarm" | "deep_research"
  status           QuickUseTaskStatus @default(RUNNING)
  input            Json               // Original message + file references
  config           Json?              // Detected tools, model, extracted params
  progress         Json?              // Current step, agent statuses, partial findings
  result           Json?              // Final QuickUseResult when complete
  creditsEstimated Int                @default(0)
  creditsUsed      Int                @default(0)
  interventions    Json?              // Array of user intervention messages
  error            String?            @db.Text
